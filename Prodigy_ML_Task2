**Create a K-means clustering algorithm to group customers of a retail store based on their purchase history.**

import java.util.*;
public class KMeansUserInput {
    public static double distance(double[] a, double[] b) {
        double sum = 0;
        for (int i = 0; i < a.length; i++)
            sum += Math.pow(a[i] - b[i], 2);
        return Math.sqrt(sum);
    }
    public static int closestCluster(double[] point, double[][] centroids) {
        int idx = 0;
        double minDist = distance(point, centroids[0]);
        for (int i = 1; i < centroids.length; i++) {
            double dist = distance(point, centroids[i]);
            if (dist < minDist) {
                minDist = dist;
                idx = i;
            }
        }
        return idx;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of customers: ");
        int n = sc.nextInt();
        double[][] data = new double[n][2];
        System.out.println("Enter electronics and groceries spend for each customer:");
        for (int i = 0; i < n; i++) {
            System.out.print("Customer " + (i + 1) + " (electronics groceries): ");
            data[i][0] = sc.nextDouble();  // electronics
            data[i][1] = sc.nextDouble();  // groceries
        }
        System.out.print("Enter number of clusters (k): ");
        int k = sc.nextInt();
        int maxIter = 100;
        int[] labels = new int[n];
        Random rand = new Random();
        // Initialize centroids randomly
        double[][] centroids = new double[k][];
        for (int i = 0; i < k; i++) {
            centroids[i] = data[rand.nextInt(n)].clone();
        }
        // K-means loop
        for (int iter = 0; iter < maxIter; iter++) {
            boolean changed = false;
            // Assign points
            for (int i = 0; i < n; i++) {
                int newLabel = closestCluster(data[i], centroids);
                if (newLabel != labels[i]) {
                    labels[i] = newLabel;
                    changed = true;
                }
            }
            if (!changed) break;
            // Update centroids
            double[][] newCentroids = new double[k][2];
            int[] counts = new int[k];
            for (int i = 0; i < n; i++) {
                int label = labels[i];
                newCentroids[label][0] += data[i][0];
                newCentroids[label][1] += data[i][1];
                counts[label]++;
            }
            for (int i = 0; i < k; i++) {
                if (counts[i] != 0) {
                    newCentroids[i][0] /= counts[i];
                    newCentroids[i][1] /= counts[i];
                }
            }
            centroids = newCentroids;
        }
        // Output result
        System.out.println("\nCustomer Clusters:");
        for (int i = 0; i < n; i++) {
            System.out.println("Customer " + (i + 1) + " assigned to cluster " + labels[i]);
        }
        sc.close();
    }
}
