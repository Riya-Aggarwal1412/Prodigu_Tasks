**Implement a linear regression model to predict the prices of houses based on their square footage and the number of bedrooms and bathrooms**

import java.util.Scanner;
public class MultiLinearRegression {
    public static void main(String[] args) {
        // Training data: {sqft, bedrooms, bathrooms}
        double[][] x = {
            {1500, 3, 2},
            {1800, 4, 2},
            {2400, 3, 3},
            {3000, 5, 4},
            {3500, 4, 3}
        };
        double[] y = {300000, 350000, 400000, 500000, 480000};
        int n = x.length;
        int f = x[0].length;
        // Add bias term (1) to features
        double[][] X = new double[n][f + 1];
        for (int i = 0; i < n; i++) {
            X[i][0] = 1; // bias
            for (int j = 0; j < f; j++) {
                X[i][j + 1] = x[i][j];
            }
        }
        // Calculate X^T * X
        double[][] XtX = new double[f + 1][f + 1];
        for (int i = 0; i < f + 1; i++) {
            for (int j = 0; j < f + 1; j++) {
                for (int k = 0; k < n; k++) {
                    XtX[i][j] += X[k][i] * X[k][j];
                }
            }
        }
        // Calculate X^T * y
        double[] Xty = new double[f + 1];
        for (int i = 0; i < f + 1; i++) {
            for (int k = 0; k < n; k++) {
                Xty[i] += X[k][i] * y[k];
            }
        }
        // Solve XtX * B = Xty using Gaussian elimination
        double[] B = gaussianElimination(XtX, Xty);
        // Get user input
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter square feet: ");
        double sqft = sc.nextDouble();
        System.out.print("Enter number of bedrooms: ");
        double bed = sc.nextDouble();
        System.out.print("Enter number of bathrooms: ");
        double bath = sc.nextDouble();
        // Predict
        double price = B[0] + B[1]*sqft + B[2]*bed + B[3]*bath;
        System.out.printf("Predicted price: $%.2f\n", price);
        sc.close();
    }
    // Gaussian elimination to solve linear system
    public static double[] gaussianElimination(double[][] A, double[] b) {
        int n = b.length;
        for (int p = 0; p < n; p++) {
            // Pivot
            int max = p;
            for (int i = p + 1; i < n; i++) {
                if (Math.abs(A[i][p]) > Math.abs(A[max][p])) max = i;
            }
            // Swap rows
            double[] temp = A[p]; A[p] = A[max]; A[max] = temp;
            double t = b[p]; b[p] = b[max]; b[max] = t;
            // Eliminate
            for (int i = p + 1; i < n; i++) {
                double alpha = A[i][p] / A[p][p];
                b[i] -= alpha * b[p];
                for (int j = p; j < n; j++) {
                    A[i][j] -= alpha * A[p][j];
                }
            }
        }
        // Back substitution
        double[] x = new double[n];
        for (int i = n - 1; i >= 0; i--) {
            double sum = 0;
            for (int j = i + 1; j < n; j++) {
                sum += A[i][j] * x[j];
            }
            x[i] = (b[i] - sum) / A[i][i];
        }
        return x;
    }
}
